<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SaunakulaApp.Views.ProfilePage"
    x:Name="PageRoot"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="20,52,20,36">

            <VerticalStackLayout Spacing="4" Margin="0,0,0,18">
                <Label Text="{Binding ProfileTitleText}" Style="{StaticResource TitleLabel}" />
                <Label Text="{Binding ProfileSubtitleText}" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsNotLoggedInVisible}"
                                 Padding="8,48"
                                 Spacing="16"
                                 HorizontalOptions="Center">
                <Label Text="&#x1F3E1;" FontSize="64" HorizontalOptions="Center" />
                <Label Text="{Binding LoginPromptText}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center" />
                <Button Text="{Binding LoginText}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="{Binding NoAccountText}" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding RegisterText}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RegisterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsLoggedInVisible}" Spacing="18">

                <Frame CornerRadius="20"
                       Padding="20"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5A7C5E" Offset="0" />
                            <GradientStop Color="#3D5C41" Offset="1" />
                        </LinearGradientBrush>
                    </Frame.Background>

                    <VerticalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="16">
                            <Frame WidthRequest="60"
                                   HeightRequest="60"
                                   CornerRadius="30"
                                   BackgroundColor="#33FFFFFF"
                                   BorderColor="Transparent"
                                   Padding="0">
                                <Label Text="{Binding AvatarText}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                <Label Text="{Binding NameText}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="{Binding EmailText}"
                                       FontSize="12"
                                       TextColor="#CCFFFFFF"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="{Binding PhoneText}"
                                       FontSize="12"
                                       TextColor="#CCFFFFFF"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#33FFFFFF" />

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding BookingsCountText}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding BookingsLabelText}"
                                       FontSize="11"
                                       TextColor="#CCFFFFFF"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding MemberSinceText}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding MemberSinceLabelText}"
                                       FontSize="11"
                                       TextColor="#CCFFFFFF"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding VipBadgeText}" FontSize="20" HorizontalOptions="Center" />
                                <Label Text="{Binding VipStatusText}"
                                       FontSize="11"
                                       TextColor="#CCFFFFFF"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="16"
                       Padding="16"
                       BorderColor="Transparent"
                       HasShadow="False"
                       BackgroundColor="{Binding VipProgressBackground}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding VipProgressTitleText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Grid.Column="1"
                                   Text="{Binding VipProgressCountText}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#FFD700" />
                        </Grid>
                        <ProgressBar Progress="{Binding VipProgress}"
                                     ProgressColor="#FFD700"
                                     BackgroundColor="#33FFFFFF"
                                     HeightRequest="8" />
                        <Label Text="{Binding VipProgressSubtitleText}"
                               FontSize="12"
                               TextColor="#CCFFFFFF"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding LanguageSectionText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Text="ET"
                                BackgroundColor="{Binding LangEtBackground}"
                                TextColor="{Binding LangEtTextColor}"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="et"
                                CornerRadius="12" />
                        <Button Grid.Column="1"
                                Text="RU"
                                BackgroundColor="{Binding LangRuBackground}"
                                TextColor="{Binding LangRuTextColor}"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="ru"
                                CornerRadius="12" />
                        <Button Grid.Column="2"
                                Text="EN"
                                BackgroundColor="{Binding LangEnBackground}"
                                TextColor="{Binding LangEnTextColor}"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="en"
                                CornerRadius="12" />
                        <Button Grid.Column="3"
                                Text="FI"
                                BackgroundColor="{Binding LangFiBackground}"
                                TextColor="{Binding LangFiTextColor}"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="fi"
                                CornerRadius="12" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding AccountSectionText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <Frame Style="{StaticResource Card}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Button Text="{Binding MyBookingsText}"
                                    Command="{Binding MyBookingsCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Text="{Binding ContactText}"
                                    Command="{Binding CallCommand}"
                                    BackgroundColor="{StaticResource PrimaryExtraLight}"
                                    TextColor="{StaticResource TextPrimary}"
                                    CornerRadius="14" />
                            <Button Text="{Binding EmailMenuText}"
                                    Command="{Binding EmailCommand}"
                                    BackgroundColor="{StaticResource PrimaryExtraLight}"
                                    TextColor="{StaticResource TextPrimary}"
                                    CornerRadius="14" />
                            <Button Text="{Binding WebsiteText}"
                                    Command="{Binding WebsiteCommand}"
                                    BackgroundColor="{StaticResource PrimaryExtraLight}"
                                    TextColor="{StaticResource TextPrimary}"
                                    CornerRadius="14" />
                            <Button Text="Instagram"
                                    Command="{Binding InstagramCommand}"
                                    BackgroundColor="{StaticResource PrimaryExtraLight}"
                                    TextColor="{StaticResource TextPrimary}"
                                    CornerRadius="14" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding FavouritesText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <CollectionView ItemsSource="{Binding Favourites}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="{Binding BindingContext.NoFavouritesText, Source={x:Reference PageRoot}}"
                                   Style="{StaticResource MutedLabel}"
                                   HorizontalOptions="Center"
                                   Margin="0,20" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0">
                                    <Grid ColumnDefinitions="84,*" ColumnSpacing="12">
                                        <Image Source="{Binding Image}"
                                               Aspect="AspectFill"
                                               WidthRequest="84"
                                               HeightRequest="72" />
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4"
                                                             Padding="0,12,12,12"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding DisplayTitle}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Text="{Binding DisplayPrice}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </VerticalStackLayout>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.OpenFavouriteCommand, Source={x:Reference PageRoot}}"
                                                                  CommandParameter="{Binding HouseId}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Button Text="{Binding LogoutText}"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="#FEE2E2"
                        TextColor="#B91C1C"
                        CornerRadius="14"
                        HeightRequest="52"
                        FontAttributes="Bold" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
