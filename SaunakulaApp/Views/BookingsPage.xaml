<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SaunakulaApp.Views.BookingsPage"
    x:Name="PageRoot"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout Spacing="0">

        <!-- Header -->
        <VerticalStackLayout Padding="20,52,20,16"
                             BackgroundColor="{StaticResource Background}">
            <Label Text="{Binding PageTitleText}"
                   Style="{StaticResource TitleLabel}"/>
            <Label Text="{Binding PageSubtitleText}"
                   Style="{StaticResource MutedLabel}"
                   Margin="0,4,0,0"/>
        </VerticalStackLayout>

        <!-- Tabs -->
        <Grid ColumnDefinitions="*,*"
              Margin="20,0,20,16"
              BackgroundColor="{StaticResource SecondaryBackground}"
              HeightRequest="44">
            <Frame Grid.Column="0"
                   BackgroundColor="{Binding UpcomingTabBackground}"
                   CornerRadius="10" Margin="4" Padding="0"
                   BorderColor="Transparent"
                   HasShadow="{Binding UpcomingTabHasShadow}">
                <Label Text="{Binding UpcomingTabText}"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="{Binding UpcomingTabTextColor}"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowUpcomingCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Frame>
            <Frame Grid.Column="1"
                   BackgroundColor="{Binding PastTabBackground}"
                   CornerRadius="10" Margin="4" Padding="0"
                   BorderColor="Transparent"
                   HasShadow="{Binding PastTabHasShadow}">
                <Label Text="{Binding PastTabText}"
                       FontSize="14"
                       TextColor="{Binding PastTabTextColor}"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowPastCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Frame>
        </Grid>

        <!-- Not logged in -->
        <VerticalStackLayout IsVisible="{Binding IsNotLoggedInVisible}"
                             VerticalOptions="CenterAndExpand"
                             HorizontalOptions="Center"
                             Spacing="16" Padding="40">
            <Label Text="&#128274;" FontSize="52" HorizontalOptions="Center"/>
            <Label Text="{Binding NotLoggedInText}"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Button Text="{Binding LoginText}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoginCommand}"/>
        </VerticalStackLayout>

        <!-- Empty state -->
        <VerticalStackLayout IsVisible="{Binding IsEmptyVisible}"
                             VerticalOptions="CenterAndExpand"
                             HorizontalOptions="Center"
                             Spacing="12" Padding="40">
            <Label Text="&#128197;" FontSize="52" HorizontalOptions="Center"/>
            <Label Text="{Binding EmptyTitleText}"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"/>
            <Label Text="{Binding EmptySubtitleText}"
                   Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Button Text="{Binding BrowseText}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding BrowseCommand}"/>
        </VerticalStackLayout>

        <!-- Bookings list -->
        <CollectionView ItemsSource="{Binding Bookings}"
                        IsVisible="{Binding IsBookingsVisible}"
                        Margin="20,0,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,16">
                        <Frame Style="{StaticResource Card}" Padding="0">
                            <VerticalStackLayout Spacing="0">

                                <Grid ColumnDefinitions="110,*">
                                    <Image Source="{Binding HouseImage}"
                                           Aspect="AspectFill"
                                           HeightRequest="110" WidthRequest="110"/>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Padding="14,12" Spacing="5"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding HouseTitle}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               LineBreakMode="TailTruncation"/>
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="&#128205;" FontSize="11"/>
                                            <Label Text="Saue vald, Harjumaa"
                                                   Style="{StaticResource MutedLabel}"
                                                   FontSize="12"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="&#128197;" FontSize="11"/>
                                            <Label Text="{Binding DateRange}"
                                                   Style="{StaticResource MutedLabel}"
                                                   FontSize="12"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="&#128101;" FontSize="11"/>
                                            <Label Text="{Binding GuestText}"
                                                   Style="{StaticResource MutedLabel}"
                                                   FontSize="12"/>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding TotalText}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               Margin="0,4,0,0"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="{StaticResource Border}"/>
                                <Grid Padding="14,10" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding StatusText}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{Binding StatusColor}"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding CancelText}"
                                           FontSize="13"
                                           TextColor="{StaticResource Destructive}"
                                           IsVisible="{Binding CanCancel}"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.CancelBookingCommand, Source={x:Reference PageRoot}}"
                                                CommandParameter="{Binding Id}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
