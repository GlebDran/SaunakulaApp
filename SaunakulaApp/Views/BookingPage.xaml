<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    x:Class="SaunakulaApp.Views.BookingPage"
    x:Name="PageRoot"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="20,52,20,20"
                      BackgroundColor="{StaticResource CardBackground}">
                    <Frame WidthRequest="40" HeightRequest="40"
                           CornerRadius="20"
                           BackgroundColor="{StaticResource SecondaryBackground}"
                           BorderColor="Transparent"
                           Padding="0" HasShadow="False">
                        <Label Text="‹" FontSize="26" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Frame>
                    <Label Text="{Binding BookingTitleText}"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Padding="20" Spacing="24">
                    <Frame Style="{StaticResource Card}" Padding="0">
                        <Grid ColumnDefinitions="100,*">
                            <Image Source="{Binding HouseImage}"
                                   Aspect="AspectFill"
                                   HeightRequest="100" WidthRequest="100" />
                            <VerticalStackLayout Grid.Column="1"
                                                 Padding="14,12" Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding HouseTitle}"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Saue vald, Harjumaa"
                                       Style="{StaticResource MutedLabel}" FontSize="12" />
                                <Label Text="{Binding HousePriceText}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>

                    <VerticalStackLayout IsVisible="{Binding IsVip}">
                        <Frame CornerRadius="14" Padding="14,12"
                               BorderColor="Transparent" HasShadow="False">
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#B8860B" Offset="0" />
                                    <GradientStop Color="#FFD700" Offset="1" />
                                </LinearGradientBrush>
                            </Frame.Background>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="👑" FontSize="18" VerticalOptions="Center" />
                                <Label Text="{Binding VipBannerText}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="#2D2000"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding TripText}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <Frame CornerRadius="16"
                               BackgroundColor="{StaticResource CardBackground}"
                               BorderColor="{StaticResource Border}"
                               Padding="14"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Button Text="‹"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            CornerRadius="17"
                                            Padding="0"
                                            BackgroundColor="{StaticResource SecondaryBackground}"
                                            TextColor="{StaticResource TextPrimary}"
                                            Command="{Binding PreviousMonthCommand}" />
                                    <VerticalStackLayout Grid.Column="1"
                                                         HorizontalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding AvailabilityCalendarText}"
                                               FontSize="13"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding CalendarMonthTitle}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2"
                                            Text="›"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            CornerRadius="17"
                                            Padding="0"
                                            BackgroundColor="{StaticResource SecondaryBackground}"
                                            TextColor="{StaticResource TextPrimary}"
                                            Command="{Binding NextMonthCommand}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4">
                                    <Label Text="E" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="T" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="2" Text="K" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="3" Text="N" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="4" Text="R" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="5" Text="L" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="6" Text="P" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                                </Grid>

                                <CollectionView ItemsSource="{Binding CalendarDays}"
                                                SelectionMode="None"
                                                HeightRequest="294">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical"
                                                         Span="7"
                                                         HorizontalItemSpacing="4"
                                                         VerticalItemSpacing="4" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame HeightRequest="44"
                                                   CornerRadius="10"
                                                   Padding="0"
                                                   HasShadow="False"
                                                   Opacity="{Binding Opacity}"
                                                   BackgroundColor="{Binding BackgroundColor}"
                                                   BorderColor="{Binding BorderColor}">
                                                <Label Text="{Binding Text}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TextColor}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding BindingContext.SelectCalendarDayCommand, Source={x:Reference PageRoot}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Frame.GestureRecognizers>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <HorizontalStackLayout Spacing="6">
                                        <BoxView WidthRequest="12"
                                                 HeightRequest="12"
                                                 CornerRadius="6"
                                                 Color="White" />
                                        <Label Text="{Binding AvailableLegendText}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                        <BoxView WidthRequest="12"
                                                 HeightRequest="12"
                                                 CornerRadius="6"
                                                 Color="#E5E7EB" />
                                        <Label Text="{Binding BookedLegendText}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                        <BoxView WidthRequest="12"
                                                 HeightRequest="12"
                                                 CornerRadius="6"
                                                 Color="#5A7C5E" />
                                        <Label Text="{Binding SelectedLegendText}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <Label Text="{Binding SelectedDatesText}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Frame>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding CheckInText}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Frame CornerRadius="14"
                                   BackgroundColor="{StaticResource MutedBackground}"
                                   BorderColor="Transparent" Padding="16,8" HasShadow="False">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Text="📅" FontSize="18" VerticalOptions="Center" />
                                    <DatePicker Grid.Column="1"
                                                Date="{Binding StartDate, Mode=TwoWay}"
                                                MinimumDate="{x:Static sys:DateTime.Today}"
                                                Format="dd.MM.yyyy"
                                                TextColor="{StaticResource TextPrimary}"
                                                BackgroundColor="Transparent" />
                                </Grid>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding CheckOutText}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Frame CornerRadius="14"
                                   BackgroundColor="{StaticResource MutedBackground}"
                                   BorderColor="Transparent" Padding="16,8" HasShadow="False">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Text="📅" FontSize="18" VerticalOptions="Center" />
                                    <DatePicker Grid.Column="1"
                                                Date="{Binding EndDate, Mode=TwoWay}"
                                                MinimumDate="{x:Static sys:DateTime.Today}"
                                                Format="dd.MM.yyyy"
                                                TextColor="{StaticResource TextPrimary}"
                                                BackgroundColor="Transparent" />
                                </Grid>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding GuestsHeaderText}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Frame CornerRadius="14"
                                   BackgroundColor="{StaticResource MutedBackground}"
                                   BorderColor="Transparent" Padding="16,12" HasShadow="False">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Label Text="👥" FontSize="18" VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding GuestsText}" FontSize="15"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="2"
                                            Text="−"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="18"
                                            Padding="0"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            BorderColor="{StaticResource Border}"
                                            TextColor="{StaticResource TextPrimary}"
                                            Command="{Binding DecreaseGuestsCommand}" />
                                    <Button Grid.Column="3"
                                            Text="+"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="18"
                                            Padding="0"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            Command="{Binding IncreaseGuestsCommand}" />
                                </Grid>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding NotesText}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Frame CornerRadius="14"
                                   BackgroundColor="{StaticResource MutedBackground}"
                                   BorderColor="Transparent" Padding="16,12" HasShadow="False">
                                <Editor Text="{Binding Notes, Mode=TwoWay}"
                                        Placeholder="{Binding NotesPlaceholderText}"
                                        HeightRequest="80"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}"
                                        PlaceholderColor="{StaticResource TextSecondary}" />
                            </Frame>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding AddonsHeaderText}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <CollectionView ItemsSource="{Binding Addons}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Style="{StaticResource Card}"
                                           Padding="12,10" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="36,*,Auto,Auto,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding Icon}" FontSize="22"
                                                   VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding DisplayName}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding DisplayPrice}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Primary}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding CountText}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center"
                                                   MinimumWidthRequest="28"
                                                   HorizontalOptions="Center" />
                                            <Button Grid.Column="3"
                                                    Text="−"
                                                    WidthRequest="34" HeightRequest="34"
                                                    CornerRadius="17"
                                                    Padding="0"
                                                    BackgroundColor="{StaticResource CardBackground}"
                                                    BorderColor="{StaticResource Border}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    IsEnabled="{Binding CanRemove}"
                                                    Command="{Binding BindingContext.RemoveAddonCommand, Source={x:Reference PageRoot}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="4"
                                                    Text="+"
                                                    WidthRequest="34" HeightRequest="34"
                                                    CornerRadius="17"
                                                    Padding="0"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    TextColor="White"
                                                    Command="{Binding BindingContext.AddAddonCommand, Source={x:Reference PageRoot}}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding PriceDetailsText}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Frame BackgroundColor="{StaticResource SecondaryBackground}"
                               CornerRadius="14" Padding="16" BorderColor="Transparent">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding NightsText}" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding SubtotalText}" Grid.Column="1"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding AddonsHeaderText}"
                                           Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding AddonsTotalText}" Grid.Column="1"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding TotalHeaderText}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding TotalText}" Grid.Column="1"
                                           FontSize="18" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <Label Text="{Binding StatusMessage}"
                           IsVisible="{Binding HasStatusMessage}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center" />

                    <Frame BackgroundColor="{StaticResource SecondaryBackground}"
                           CornerRadius="14" Padding="16" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding CancellationText}"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✓" TextColor="{StaticResource Primary}"
                                       FontAttributes="Bold" />
                                <Label Text="Tasuta tühistamine 48h enne saabumist"
                                       Style="{StaticResource MutedLabel}" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✓" TextColor="{StaticResource Primary}"
                                       FontAttributes="Bold" />
                                <Label Text="Kontakt: +372 5500 075"
                                       Style="{StaticResource MutedLabel}" FontSize="13" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <BoxView HeightRequest="8" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" Padding="20,12"
              BackgroundColor="{StaticResource CardBackground}">
            <BoxView HeightRequest="1"
                     BackgroundColor="{StaticResource Border}"
                     VerticalOptions="Start" />
            <Button Text="{Binding ConfirmButtonText}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanConfirm}"
                    Command="{Binding ConfirmBookingCommand}"
                    Margin="0,4,0,0" />
        </Grid>
    </Grid>
</ContentPage>
